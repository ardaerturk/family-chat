# SERVER ONLY. Never prefix these variables with NEXT_PUBLIC_.
APP_ORIGIN=http://localhost:3000
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-locally
AZURE_CHAT_MODELS='[{"id":"your-deployment","label":"My model","description":"Private Azure deployment","reasoning":true}]'
AZURE_STORAGE_CONNECTION_STRING=replace-locally
# Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
# Generate a strong independent random secret for the scheduled cleanup endpoint.
CRON_SECRET=replace-locally
# Optional realtime voice; omit all three to hide voice in the UI.
AZURE_REALTIME_ENDPOINT=https://your-voice-resource.openai.azure.com
AZURE_REALTIME_API_KEY=replace-locally
AZURE_REALTIME_MODEL=your-realtime-deployment
